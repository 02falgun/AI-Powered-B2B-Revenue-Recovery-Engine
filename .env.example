# Supabase Configuration
# The project URL is non-sensitive (used by both server and middleware).
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
# Service-role key — server-side only. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Gemini Configuration
GEMINI_API_KEY=your-gemini-api-key

# Razorpay Configuration (Test Mode)
# KEY_ID is public-safe and used in the browser for the checkout modal.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Upstash Redis & Rate Limiting Configuration (Free Tier)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token
RATE_LIMIT_USER_MAX=20
RATE_LIMIT_USER_WINDOW_MS=3600000
RATE_LIMIT_GLOBAL_MAX=60
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
MAX_EMAIL_BODY_CHARS=10000
